# =============================================================================
# BAWAKARAENG HUB — Template Variabel Environment
# Salin file ini menjadi .env.local (development) atau isi di Vercel Dashboard.
# Jangan pernah commit nilai rahasia ke git.
# =============================================================================

# --- Aplikasi ---
# URL domain resmi aplikasi (dipakai untuk validasi CORS)
APP_ORIGIN=https://bawakaraeng-hub.vercel.app
ALLOWED_ORIGINS=https://bawakaraeng-hub.vercel.app

# --- Supabase ---
# URL proyek Supabase (bisa dilihat di Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Kunci publik (anon) — aman dipakai di client, tidak perlu disembunyikan
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Kunci service role — RAHASIA, hanya untuk server, jangan commit
SUPABASE_SERVICE_ROLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# --- AI (Gemini) ---
# Kunci API Google Gemini — dapatkan di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model Gemini yang dipakai (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- AI Cadangan Lapis 2 (opsional — Groq, OpenRouter, dll) ---
# Penyedia OpenAI-compatible. Kosongkan bila tidak dipakai.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- AI Cadangan Lapis 3 (opsional) ---
AI2_API_KEY=
AI2_BASE_URL=https://openrouter.ai/api/v1
AI2_MODEL=openrouter/free

# --- Web Push (SOS Notifikasi) ---
# Buat pasangan kunci baru: npx web-push generate-vapid-keys
# Simpan KEDUA kunci dari output perintah di atas.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@bawakaraeng-hub.vercel.app

# --- Data Sumber Eksternal ---
# Kode wilayah BMKG untuk cuaca Bawakaraeng (adm4)
BMKG_ADM4=73.06.04.1010
# Kunci API NASA FIRMS untuk data titik panas — daftar di https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# --- Admin ---
# Daftar email yang mendapat akses panel admin (pisah koma)
ADMIN_EMAILS=admin@contoh.com,ranger@contoh.com
